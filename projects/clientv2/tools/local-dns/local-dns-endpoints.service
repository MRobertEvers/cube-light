[Unit]
Description=local-dns endpoints: records each WireGuard peer's public address for local-dns
After=wg-quick@wg0.service
Requires=wg-quick@wg0.service
PartOf=wg-quick@wg0.service

[Service]
# Root only for `wg show`; it writes a world-readable file and runs nothing else.
ExecStart=/opt/local-dns/wg-endpoints.sh wg0
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target wg-quick@wg0.service
