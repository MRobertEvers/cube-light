{
	"compilerOptions": {
		"outDir": "./dist",
		"sourceMap": true,
		"module": "ESNext",
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"target": "ES6",
		"lib": ["DOM", "WebWorker", "ESNext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"moduleResolution": "Bundler",
		"types": ["vite/client"],
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noImplicitAny": true,
		"paths": {
			"src/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
