{
	"name": "cube-project",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "vite --port 3000",
		"start": "npm run dev",
		"build": "vite build",
		"preview": "vite preview --port 3000",
		"typecheck": "tsc --noEmit",
		"build:wasm": "npm run build:wasm:banner-blend && npm run build:wasm:card-list-lint",
		"build:wasm:banner-blend": "emcc native/banner_blend.c -O3 -Wall -Wextra -Wno-unused-parameter -sSTANDALONE_WASM=1 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=16777216 -sEXPORTED_FUNCTIONS='[\"_malloc\",\"_free\"]' --no-entry -o src/wasm/banner-blend.wasm",
		"build:wasm:card-list-lint": "emcc native/card_list_lint.c -O3 -Wall -Wextra -sSTANDALONE_WASM=1 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=16777216 -sEXPORTED_FUNCTIONS='[\"_malloc\",\"_free\"]' --no-entry -o src/wasm/card-list-lint.wasm",
		"install:ocr": "node ../../scripts/ocr-assets.mjs install",
		"verify:ocr": "node ../../scripts/ocr-assets.mjs verify",
		"prebuild": "npm run verify:ocr",
		"test": "node --import ./test/register.mjs --test test/*.test.ts"
	},
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@paddleocr/paddleocr-js": "0.4.2",
		"@reduxjs/toolkit": "^2.12.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-redux": "^9.3.0",
		"react-router-dom": "^7.18.4",
		"redux": "^5.0.1",
		"@techstark/opencv-js": "4.10.0-release.1",
		"transformers-v4": "npm:@huggingface/transformers@4.3.0",
		"tesseract.js": "7.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
