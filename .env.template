# cube-light's local settings. Copy this file to .env (git ignores it) and edit.
# The API server (projects/server) and the client server (deploy/serve-client.mjs) read .env from
# the repository's root, or the file CUBE_ENV_FILE names; a variable already set in the
# environment wins over the file. KEY=VALUE per line; values are not expanded ($OTHER stays as is).

# The client server: the built client (projects/clientv2/dist) and /api, passed to the API server.
# This is the port a reverse proxy sends the site's traffic to.
CUBE_CLIENT_HOST=0.0.0.0
CUBE_CLIENT_PORT=4089
# Earlier builds' hashed files (dist/assets), kept so a tab still running an older build can load
# its lazy chunks; add each build with scripts/retain-client-assets.mjs (deploy/README.md).
#CLIENT_ASSET_ROOT=/path/to/client-assets

# The API server. Behind the client server it need only listen on this machine.
CUBE_API_HOST=127.0.0.1
CUBE_API_PORT=4040

# Pages allowed to sign in and make changes (comma-separated). Unset: any page on the API's own
# host name, which a reverse proxy that rewrites Host does not keep.
CLIENT_ORIGINS=https://cube-light.example.com

# Proxies trusted to name the browser's address (Express's "trust proxy"): the client server on
# this machine and the reverse proxy's network. The sign-in limits count per address.
CUBE_TRUST_PROXY=loopback

# This server's own application database (decks, collections, accounts). Unset: database.sqlite in
# the API server's working folder.
#CUBE_DATABASE=/path/to/cube-light/projects/server/database.sqlite

# The application database's shared copy on the NAS, the second level behind this server's own
# (projects/server/readme.md, "Shared database"). Unset: this server keeps to its own.
#   Linux (GNOME's SMB mount): /run/user/1000/gvfs/smb-share:server=tande.local,share=matthewllm_shared/cube-light/database/cube-light-application-database.sqlite
#   macOS: /Volumes/MatthewLLM_Shared/cube-light/database/cube-light-application-database.sqlite
#CUBE_SHARED_DATABASE=
# How often to take the other servers' changes, and how soon after a change here to give it.
#CUBE_SHARED_SYNC_SECONDS=300
#CUBE_SHARED_CHANGE_SECONDS=30

# The card art cache (3rd/artcache/FORMAT.md), shared with torimtgd. Unset: artcache's default,
# <per-user data>/torimtg/scryfall_cache.
#TORIMTG_ART_CACHE=/path/to/mtg-ai-assets/scryfall
# A second art cache behind it (the NAS's), as torimtgd's --art-mirror: an image the cache lacks is
# copied from here before Scryfall is asked, and what Scryfall brings is copied here.
#TORIMTG_ART_MIRROR=/run/user/1000/gvfs/smb-share:server=tande.local,share=matthewllm_shared/mtg-ai-assets/scryfall

# Parallax art: 0 turns height maps off.
#CUBELIGHT_DEPTH=0
